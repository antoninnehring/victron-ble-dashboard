# Victron Instant Readout devices: ADDRESS=ENCRYPTION_KEY,ADDRESS=ENCRYPTION_KEY
# Addresses come from `python3 ble-reader/scan.py`.
# Keys come from VictronConnect → device → Settings → Product Info → Instant Readout.
VICTRON_DEVICES=AA:BB:CC:DD:EE:FF=0123456789abcdef0123456789abcdef

# How often the reader writes ble-data.json (seconds)
BLE_INTERVAL=15

# Optional: address of the BMS/shunt that should win for SOC/current/voltage.
# On macOS this is often a UUID, not a MAC. Leave unset to merge all devices equally.
# VICTRON_BMS_ADDRESS=

# Optional friendly names: ADDRESS=Name,ADDRESS=Name
# VICTRON_DEVICE_NAMES=AA:BB:CC:DD:EE:FF=SmartSolar

# Solar forecast. If unset, the dashboard asks the browser for location.
# SITE_LAT=48.8566
# SITE_LON=2.3522
# Optional array nameplate in watts; otherwise inferred from observed peak.
# SITE_CAPACITY_W=1000
